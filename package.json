{
  "name": "mtiny-retos",
  "version": "1.0.0",
  "private": true,
  "description": "Retos visuales para programar el robot mTiny (castellano y catalán)",
  "scripts": {
    "build": "bash build.sh",
    "assets": "capacitor-assets generate --android --iconBackgroundColor '#CFEEFF' --splashBackgroundColor '#E8F6FF'",
    "sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@fontsource/fredoka": "^5.0.0"
  }
}
